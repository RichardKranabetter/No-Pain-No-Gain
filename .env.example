# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# Anthropic API key, used for the transcript safety/relevance check
ANTHROPIC_API_KEY=

# Comma-separated list of trusted/certified physio channel IDs
YOUTUBE_WHITELISTED_CHANNEL_IDS=UCxxxxxxxxxxxxxxxxxxxxxx,UCyyyyyyyyyyyyyyyyyyyyyy
